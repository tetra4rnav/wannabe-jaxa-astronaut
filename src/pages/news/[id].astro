---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { NewsDetail } from '../../components/NewsDetail';
import { loadNewsFile } from '../../lib/news-store';

const { id } = Astro.params;
if (!id) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

const news = await loadNewsFile();
const item = news.items.find((i) => i.id === id);
if (!item) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

const title = item.titleJa || item.titleOriginal || 'ニュース';
---

<SiteLayout title={title} description={item.summaryJa || item.summaryOriginal || undefined} skipMdAlternate>
	<p class="mb-4 text-sm text-muted-foreground">
		<a href="/news/">← ニュース一覧</a>
	</p>

	<NewsDetail item={item} />
</SiteLayout>
