---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { AdminApp } from '../../components/admin/AdminApp';
import { adminNavGroups, parseAdminSection } from '../../lib/admin-nav';

export const prerender = false;

const section = parseAdminSection(Astro.url.searchParams.get('section'));
const slug = Astro.url.searchParams.get('slug');
---

<SiteLayout
	title="管理コンソール"
	description="カタログと RAG 監査"
	skipMdAlternate
	heading={false}
	navGroups={adminNavGroups()}
>
	<AdminApp client:load section={section} slug={slug} />
</SiteLayout>
