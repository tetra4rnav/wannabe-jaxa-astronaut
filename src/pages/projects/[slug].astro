---
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
	PROJECT_BY_SLUG,
	countryFlag,
	listProjectPages,
	phaseLabelJa,
	relationLabelJa,
} from '../../config/projects';
import { ProjectTimeline } from '../../components/ProjectTimeline';

export const prerender = true;

export function getStaticPaths() {
	return listProjectPages().map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = slug ? PROJECT_BY_SLUG[slug] : undefined;
const flags =
	project?.countries && project.countries.length > 0
		? project.countries.map((c) => countryFlag(c)).join('')
		: '';
---

<SiteLayout
	title={project?.nameJa ?? 'プロジェクト'}
	description={
		project ? `${project.nameEn} の公式経緯とニュースの時系列` : 'プロジェクト時系列'
	}
	skipMdAlternate
>
	{
		project ? (
			<>
				{(flags || project.kindJa) && (
					<p class="mb-2 text-sm">
						{flags ? (
							<span class="tracking-wide" title={project.countries?.join(', ')}>
								{flags}
							</span>
						) : null}
						{flags && project.kindJa ? ' · ' : null}
						{project.kindJa ? (
							<span class="text-muted-foreground">{project.kindJa}</span>
						) : null}
					</p>
				)}
				<p class="mb-4 text-sm text-muted-foreground">
					{project.nameEn}
					{project.phase ? ` · ${phaseLabelJa(project.phase)}` : ''}
					{project.role === 'seed'
						? ' · 種'
						: project.role === 'related'
							? ' · 関係先'
							: project.role === 'retired'
								? ' · 引退'
								: ''}
					{' '}
					· <a href={`/projects/${project.slug}/timeline.json`}>timeline.json</a>
				</p>
				{project.relations && project.relations.length > 0 ? (
					<ul class="mb-4 space-y-1 text-sm">
						{project.relations.map((r) => {
							const target = PROJECT_BY_SLUG[r.target];
							return (
								<li>
									{relationLabelJa(r.type)} →{' '}
									<a href={`/projects/${r.target}/`}>{target?.nameJa ?? r.target}</a>
								</li>
							);
						})}
					</ul>
				) : null}
				<ProjectTimeline client:load slug={project.slug} />
			</>
		) : (
			<p>不明なプロジェクトです。</p>
		)
	}

	<p class="mt-6">
		<a href="/projects/">← プロジェクト一覧</a>
	</p>
</SiteLayout>
