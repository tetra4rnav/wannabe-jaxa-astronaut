---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { PROJECT_BY_SLUG, listCatalogProjects } from '../../config/projects';
import { ProjectTimeline } from '../../components/ProjectTimeline';
import SiteDisclaimer from '../../components/SiteDisclaimer.astro';

export const prerender = true;

export function getStaticPaths() {
	return listCatalogProjects().map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = slug ? PROJECT_BY_SLUG[slug] : undefined;
---

<SiteLayout
	title={project?.nameJa ?? 'プロジェクト'}
	description={
		project ? `${project.nameEn} の公式経緯とニュースの時系列` : 'プロジェクト時系列'
	}
	skipMdAlternate
>
	<SiteDisclaimer>
		公式マイルストーンとニュースを混在表示します。Wiki 本文はこのページでは書き換えません。
	</SiteDisclaimer>

	{
		project ? (
			<>
				<p class="mb-4 text-sm text-muted-foreground">
					{project.nameEn}
					{project.wikiDocsId ? (
						<>
							{' '}
							· <a href={`/${project.wikiDocsId}/`}>関連 Wiki</a>
						</>
					) : null}
					{' '}
					· <a href={`/projects/${project.slug}/timeline.json`}>timeline.json</a>
				</p>
				<ProjectTimeline client:load slug={project.slug} />
			</>
		) : (
			<p>不明なプロジェクトです。</p>
		)
	}

	<p class="mt-6">
		<a href="/projects/">← プロジェクト一覧</a>
	</p>
</SiteLayout>
