---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { listCatalogProjects } from '../../config/projects';
import SiteDisclaimer from '../../components/SiteDisclaimer.astro';

const projects = listCatalogProjects();
---

<SiteLayout
	title="プロジェクト時系列"
	description="公式資料とニュースをプロジェクトごとの時間軸で並べます。"
	skipMdAlternate
>
	<SiteDisclaimer>
		分類は人手のカタログに対するキーワード照合です。未分類は「未分類」に残します。
	</SiteDisclaimer>

	<ul class="space-y-3">
		{
			projects.map((p) => (
				<li>
					<a href={`/projects/${p.slug}/`}>{p.nameJa}</a>
					<span class="text-sm text-muted-foreground"> — {p.nameEn}</span>
				</li>
			))
		}
	</ul>
</SiteLayout>
