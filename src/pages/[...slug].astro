---
import { render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import FactCheckHistory from '../components/FactCheckHistory.astro';
import { WikiMermaid } from '../components/WikiMermaid';
import {
	docIdToSlug,
	getPublishedDocs,
	slugToHref,
} from '../lib/docs';

export const prerender = true;

export async function getStaticPaths() {
	const docs = await getPublishedDocs();
	return docs.map((entry) => {
		const slug = docIdToSlug(entry.id);
		return {
			params: { slug },
			props: { entry, docsId: slug },
		};
	});
}

const { entry, docsId } = Astro.props;
const { Content } = await render(entry);
const showFactCheck = docsId.includes('/');
---

<SiteLayout
	title={entry.data.title}
	description={entry.data.description}
	docsId={docsId}
>
	{entry.data.sources?.length ? (
		<p class="mb-4 text-sm text-muted-foreground">
			出典:{' '}
			{entry.data.sources.map((url, i) => (
				<>
					{i > 0 ? ' · ' : ''}
					<a href={url} rel="noopener noreferrer">
						{new URL(url).hostname}
					</a>
				</>
			))}
		</p>
	) : null}
	<div class="wiki-prose">
		<Content />
	</div>
	{docsId === 'about' && <WikiMermaid client:idle />}
	{showFactCheck && <FactCheckHistory docsId={docsId} />}
	{docsId.includes('/') && (
		<p class="mt-8 text-sm">
			<a href={slugToHref(docsId.split('/')[0]!)}>← テーマ一覧</a>
		</p>
	)}
</SiteLayout>
