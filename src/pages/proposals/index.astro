---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { ProposalsList } from '../../components/ProposalsList';

const newsId = Astro.url.searchParams.get('news');
---

<SiteLayout
	title="Wiki 構築提案"
	description="ニュースをきっかけに、LLM が Wiki の追記・新規の案を出します。本文は人が書きます。"
	skipMdAlternate
>
	<p class="mb-4 text-sm text-muted-foreground">
		<a href="/proposals.json">proposals.json</a>
		{newsId ? <> · フィルタ: news=<code>{newsId}</code></> : null}
	</p>

	<ProposalsList client:load newsId={newsId} />
</SiteLayout>
