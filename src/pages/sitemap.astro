---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';

const docs = (await getCollection('docs')).filter((d) => !d.id.includes('_template'));

function hrefFor(id: string): string {
	if (id === 'index') return '/';
	return `/${id}/`;
}

function mdFor(id: string): string {
	if (id === 'index') return '/index.md';
	return `/${id}.md`;
}

const byFolder = new Map<string, typeof docs>();
for (const doc of docs) {
	const folder = doc.id.includes('/') ? doc.id.split('/')[0]! : '_root';
	const list = byFolder.get(folder) ?? [];
	list.push(doc);
	byFolder.set(folder, list);
}

const folderOrder = ['_root', ...[...byFolder.keys()].filter((k) => k !== '_root').sort()];
---

<StarlightPage
	frontmatter={{
		title: 'サイトマップ',
		description: 'Wiki・ニュース・機械可読ミラーへの静的リンク一覧。',
	}}
>
	<aside class="site-disclaimer" role="note">
		<strong>非公式:</strong> 本サイトは JAXA・宇宙機関の公式サイトではありません。クロール用の HTML
		ハブです。
	</aside>

	<section>
		<h2>主要ページ</h2>
		<ul>
			<li><a href="/">ホーム</a> · <a href="/index.md">index.md</a></li>
			<li><a href="/news/">ニュース</a> · <a href="/news.md">news.md</a> · <a href="/news.json">news.json</a></li>
			<li><a href="/projects/">プロジェクト時系列</a> · <a href="/projects/catalog.json">catalog.json</a></li>
			<li><a href="/proposals/">Wiki 構築提案</a> · <a href="/proposals.json">proposals.json</a></li>
			<li><a href="/about/">このサイトについて</a> · <a href="/about.md">about.md</a></li>
			<li><a href="/sitemap/">サイトマップ（このページ）</a></li>
		</ul>
	</section>

	<section>
		<h2>Wiki</h2>
		{
			folderOrder.map((folder) => {
				const pages = (byFolder.get(folder) ?? []).sort((a, b) => a.id.localeCompare(b.id));
				const label = folder === '_root' ? 'ルート' : folder;
				return (
					<div>
						<h3>{label}</h3>
						<ul>
							{pages.map((doc) => (
								<li>
									<a href={hrefFor(doc.id)}>{doc.data.title}</a>
									{' · '}
									<a href={mdFor(doc.id)}>Markdown</a>
								</li>
							))}
						</ul>
					</div>
				);
			})
		}
	</section>

	<section>
		<h2>機械可読ミラー</h2>
		<ul>
			<li><a href="/llms.txt">/llms.txt</a></li>
			<li><a href="/llms-full.txt">/llms-full.txt</a></li>
			<li><a href="/llms-small.txt">/llms-small.txt</a></li>
			<li><a href="/news.md">/news.md</a></li>
			<li><a href="/news.json">/news.json</a></li>
			<li><a href="/corpus/manifest.json">/corpus/manifest.json</a></li>
			<li><a href="/corpus/chunks.jsonl">/corpus/chunks.jsonl</a></li>
			<li><a href="/corpus/wiki.jsonl">/corpus/wiki.jsonl</a></li>
			<li><a href="/corpus/news.jsonl">/corpus/news.jsonl</a></li>
			<li><a href="/sitemap-index.xml">/sitemap-index.xml</a></li>
			<li><a href="/robots.txt">/robots.txt</a></li>
		</ul>
	</section>
</StarlightPage>
