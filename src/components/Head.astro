---
import Default from '@astrojs/starlight/components/Head.astro';

const route = Astro.locals.starlightRoute;
const id = route?.id ?? '';
const site = (Astro.site?.origin ?? 'https://wannabe-jaxa-astronaut.jh1cid.workers.dev').replace(
	/\/$/,
	'',
);
const data = route?.entry?.data as {
	title?: string;
	description?: string;
	sources?: string[];
	reviewed?: string;
} | undefined;

const isHome = id === 'index' || id === '';
const is404 = id === '404';
const skipMdAlternate = is404 || id === 'sitemap';
const mdHref = isHome ? '/index.md' : `/${id}.md`;

type JsonLd = Record<string, unknown>;
const graphs: JsonLd[] = [];

if (isHome) {
	graphs.push({
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: route?.siteTitle ?? 'JAXA宇宙飛行士志望Wiki',
		url: `${site}/`,
		description:
			data?.description ??
			'JAXA非公式。公式出典のみのWikiと、各国公式ニュースの原語＋日本語対照サイト。',
		inLanguage: 'ja',
	});
} else if (!is404 && id !== 'news' && id !== 'sitemap' && data?.title) {
	const pagePath = `/${id}/`;
	const pageUrl = `${site}${pagePath}`;
	const article: JsonLd = {
		'@context': 'https://schema.org',
		'@type': 'Article',
		headline: data.title,
		description: data.description,
		inLanguage: 'ja',
		url: pageUrl,
		mainEntityOfPage: pageUrl,
	};
	if (data.reviewed) article.dateModified = data.reviewed;
	if (data.sources?.length) {
		article.citation = data.sources.map((url) => ({
			'@type': 'CreativeWork',
			url,
		}));
	}
	graphs.push(article);

	const parts = id.split('/').filter(Boolean);
	const items: JsonLd[] = [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'ホーム',
			item: `${site}/`,
		},
	];
	let acc = '';
	parts.forEach((part, i) => {
		acc += `${acc ? '/' : ''}${part}`;
		const last = i === parts.length - 1;
		items.push({
			'@type': 'ListItem',
			position: i + 2,
			name: last ? data.title! : part,
			item: `${site}/${acc}/`,
		});
	});
	graphs.push({
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: items,
	});
}
---

<Default />
{!skipMdAlternate && (
	<link rel="alternate" type="text/markdown" title="Markdown" href={mdHref} />
)}
<link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
{graphs.map((g) => (
	<script type="application/ld+json" set:html={JSON.stringify(g)} />
))}
