---
const themes = [
	{ href: '/policy/', title: '政策・制度', desc: '宇宙基本計画・予算・国際枠組み' },
	{ href: '/astronauts/', title: '宇宙飛行士', desc: '一覧・インタビューテーマ・個人ページ' },
	{ href: '/society/', title: '社会学', desc: '月面社会など' },
	{ href: '/physiology/', title: '生理学', desc: '微小重力など' },
	{ href: '/satellites/', title: '人工衛星', desc: '概要と公式資料' },
];
---

<div class="folder-grid">
	{
		themes.map((t) => (
			<a href={t.href}>
				<strong>{t.title}</strong>
				<br />
				<span class="mt-hint">{t.desc}</span>
			</a>
		))
	}
</div>
