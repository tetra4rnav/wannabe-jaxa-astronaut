---
import Default from '@astrojs/starlight/components/Footer.astro';

const id = Astro.locals.starlightRoute?.id ?? '';
const skipMd = id === '404' || id === 'sitemap';
const mdHref = id === 'index' || id === '' ? '/index.md' : `/${id}.md`;
---

<footer class="sl-flex page-extra-links">
	<p class="mt-hint">
		{!skipMd && (
			<>
				<a href={mdHref}>このページの Markdown</a>
				{' · '}
			</>
		)}
		<a href="/llms.txt">llms.txt</a>
		·
		<a href="/sitemap/">サイトマップ</a>
		·
		<a href="/corpus/manifest.json">RAG コーパス</a>
	</p>
</footer>
<Default><slot /></Default>
