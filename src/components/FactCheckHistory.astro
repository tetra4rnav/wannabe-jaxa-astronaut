---
import { getFactCheckEntries } from '../utils/fact-checks';
import type { FactCheckEntry } from '../utils/fact-checks';

const id = Astro.locals.starlightRoute?.id ?? '';
const skip = !id || id === 'index' || id === 'about' || id.startsWith('_template');
let entries: FactCheckEntry[] = [];
if (!skip) {
	entries = getFactCheckEntries(id);
}

const verdictLabel: Record<string, string> = {
	pass: '合格',
	'needs-update': '要更新',
	failed: '失敗',
};

const verdictClass: Record<string, string> = {
	pass: 'bg-emerald-700/80 text-emerald-50',
	'needs-update': 'bg-amber-700/80 text-amber-50',
	failed: 'bg-red-700/80 text-red-50',
};
---

{
	!skip && (
		<section class="mt-8" aria-labelledby="fact-check-heading">
			<h2 id="fact-check-heading" class="mb-3 text-lg font-semibold">
				ファクトチェック履歴
			</h2>
			{entries.length === 0 ? (
				<p class="text-sm text-muted-foreground">未実施</p>
			) : (
				<div class="flex flex-col gap-3">
					{entries.map((e) => (
						<div class="rounded-lg border border-border bg-card p-4 text-card-foreground shadow-sm">
							<div class="mb-2 flex items-center justify-between gap-2">
								<strong class="text-sm">{e.date}</strong>
								<span
									class:list={[
										'inline-flex rounded-md px-2 py-0.5 text-xs font-medium',
										verdictClass[e.verdict] ?? 'bg-secondary text-secondary-foreground',
									]}
								>
									{verdictLabel[e.verdict] ?? e.verdict}
								</span>
							</div>
							{e.model ? (
								<p class="text-xs text-muted-foreground">{e.model}</p>
							) : null}
							{e.summary ? <p class="mt-2 text-sm">{e.summary}</p> : null}
							{e.issues?.length ? (
								<ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
									{e.issues.map((issue) => (
										<li>{issue}</li>
									))}
								</ul>
							) : null}
						</div>
					))}
				</div>
			)}
		</section>
	)
}
