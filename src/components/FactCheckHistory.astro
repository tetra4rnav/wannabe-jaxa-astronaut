---
import { FactCheckHistoryClient } from './FactCheckHistoryClient';

interface Props {
	docsId: string;
}

const { docsId } = Astro.props;
const skip = !docsId || docsId === 'index' || docsId === 'about' || docsId.startsWith('_template');
---

{!skip && <FactCheckHistoryClient client:load docsId={docsId} />}
