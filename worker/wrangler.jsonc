{
	"name": "wannabe-jaxa-jobs",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-20",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	"ai": {
		"binding": "AI"
	},
	"kv_namespaces": [
		{
			"binding": "STORE",
			"id": "e6e6affaab6e4dc489d0d1121e2bc2f9",
			"preview_id": "40c541c4592240a68f2311f1c018f355"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wannabe-jaxa-db",
			"database_id": "4f5ba07d-18bc-49c4-a664-95ab92206770",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "CHUNKS",
			"bucket_name": "wannabe-jaxa-chunks"
		}
	],
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "wannabe-jaxa-vectors"
		}
	],
	"workflows": [
		{
			"name": "wannabe-fetch-news",
			"binding": "FETCH_NEWS",
			"class_name": "FetchNewsWorkflow",
			"schedules": ["0 */6 * * *"]
		},
		{
			"name": "wannabe-fact-check",
			"binding": "FACT_CHECK",
			"class_name": "FactCheckWorkflow",
			"schedules": ["0 3 * * 1"]
		},
		{
			"name": "wannabe-ingest-corpus",
			"binding": "INGEST_CORPUS",
			"class_name": "IngestCorpusWorkflow",
			"schedules": ["0 */12 * * *"]
		},
		{
			"name": "wannabe-propose-wiki",
			"binding": "PROPOSE_WIKI",
			"class_name": "ProposeWikiWorkflow",
			"schedules": ["15 */6 * * *"]
		}
	]
}
